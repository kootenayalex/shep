# --- BRAIN -------------------------------------------------------------------

BRAIN_PROMPT = """You are the overseer of a shep session: a personal assistant that narrates, never acts.
Hard rules you must respect in what you write:
1. You never answer for an agent. A blocked agent is the person's to answer; you may draft a suggested answer with a reason.
2. You never touch the server, restart anything, or kill anything.
3. You never nudge or queue prompts.
4. You never write to the docket: what is owed is said on the board, and the person keeps their own list.

Given the situation below, answer with EXACTLY one fenced block and nothing else:

```board
## <the agent's name only: the text before the first ` · ` on its situation line — never its state word or age>
<one or two short sentences: what it is doing or last said, and — if it is blocked — the visible prompt, your suggested answer and why>
## <the next agent, the same way>
## room
<one to three short sentences on what cuts across the agents: what the docket owes, what health says, what you would look at first>
```

One `##` section per agent in the situation, blocked agents first; `## room` last, always present; at most {max_board} lines in all. Plain prose inside a section — no tables, no bullets, no nested headings. The screen already shows every agent's state word and every docket item, so say what the state word cannot.

The situation below is already sensed for you: read it first and answer from it, because that is the fast path and usually the whole answer. You also have shep's own tools as `mcp__shep__*`, bounded to looking and paging: use `agent_read` only when a blocked agent's exact screen decides what you would write and the situation does not show it, and `push_page` to page the phone when something genuinely cannot wait. No tool acts on an agent or on the docket; there is no tool that types, queues, restarts, kills or files, and an unlisted tool is a forbidden one.

{situation}
"""


# The `shep mcp` profile the brain is asked with: read and paging. `[plugins.overseer] tools` narrows or widens it; the tool list, not
# this prompt, is what the rules above actually rest on.
MCP_PROFILE = "overseer"


def ask_brain(runtime: str, situation: str) -> str | None:
    prompt = BRAIN_PROMPT.format(max_board=MAX_BOARD_LINES, situation=situation)
    try:
        proc = subprocess.run(
            [
                shep_bin(),
                "runtime",
                "ask",
                runtime,
                "-",
                "--timeout",
                str(BRAIN_TIMEOUT_SECONDS),
                "--mcp-profile",
                MCP_PROFILE,
            ],
            input=prompt,
            capture_output=True,
            text=True,
            timeout=BRAIN_TIMEOUT_SECONDS + 10,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        sys.stderr.write(f"overseer: brain call failed: {exc}\n")
        return None
    if proc.returncode != 0:
        sys.stderr.write(f"overseer: brain exited {proc.returncode}: {proc.stderr.strip()[:200]}\n")
        return None
    return proc.stdout


FENCE_RE = re.compile(r"```board\s*\n(.*?)```", re.DOTALL)


def parse_brain_answer(answer: str) -> str | None:
    """Pull the board out of the brain's reply.

    Anything malformed degrades to "no board" rather than to a half-applied
    answer; the deterministic board then stands. A brain that still answers
    with a second fenced block (an older prompt's habit) loses nothing but
    that block: the board is the first `board` fence and nothing else is
    read, so nothing it says can reach the docket.
    """
    for body in FENCE_RE.findall(answer or ""):
        return "\n".join(body.rstrip("\n").splitlines()[:MAX_BOARD_LINES]) + "\n"
    return None


def normalize_brain_board(board: str, facts: dict) -> str:
    """Make the brain's board wear the shape the readers seat: a header
    line first, and each `## title` reduced to the agent's section name when
    the brain padded it (`## Dev · done 7m` → `## Dev`), so the desktop and
    the phone find the row it belongs under. Titles that name nothing known
    are left alone; `## Room` is `## room`."""
    agents = (facts.get("overview") or {}).get("agents") or []
    names = [section_name(a, agents) for a in agents]
    out: list[str] = []
    for line in board.rstrip("\n").splitlines():
        if line.startswith("## "):
            title = line[3:].strip()
            if title.lower() == "room":
                title = "room"
            elif title not in names:
                for name in sorted(names, key=len, reverse=True):
                    if title == name or title.startswith(name + " · "):
                        title = name
                        break
            line = f"## {title}"
        out.append(line)
    if not out or not out[0].startswith("OVERSEER ·"):
        out.insert(0, f"OVERSEER · {facts['at']} · brain")
    return "\n".join(out[:MAX_BOARD_LINES]) + "\n"


def brain_allowed(stamp: Path, now: float) -> bool:
    try:
        return now - stamp.stat().st_mtime >= BRAIN_INTERVAL_SECONDS
    except OSError:
        return True


# --- MAIN --------------------------------------------------------------------


def main(argv: list[str]) -> int:
    from_event = "--event" in argv
    out = state_dir()
    facts = sense()
    situation = situation_markdown(facts)
    (out / "situation.json").write_text(json.dumps(facts, indent=1, sort_keys=True) + "\n")
    (out / "situation.md").write_text(situation)

    board = deterministic_board(facts)
    note = "deterministic"
    source = "deterministic"
    runtime = brain_runtime()
    stamp = out / "last-brain"
    source_file = out / "BOARD.md.source"
    if runtime and brain_allowed(stamp, time.time()):
        answer = ask_brain(runtime, situation)
        stamp.touch()
        brain_board = parse_brain_answer(answer or "")
        if brain_board:
            board = normalize_brain_board(brain_board, facts)
            note = f"brain {runtime}"
            source = "brain"
    elif runtime and from_event and source_file.exists() and source_file.read_text().strip() == "brain":
        # Inside the window an event only refreshes the situation; the
        # brain's narrative stays on the board until its next turn.
        board = None
        note = "deterministic (brain within its 10 min window; board kept)"

    if board is not None:
        (out / "BOARD.md").write_text(board)
        source_file.write_text(source + "\n")
    with (out / "journal.log").open("a") as journal:
        journal.write(f"{facts['at']} tick {facts.get('event') or 'manual'} {note}\n")
    sys.stdout.write(board)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
